{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontoforge.local/schema/candidates/m8-2/local-link-binding-v2-bridge.candidate.schema.json",
  "title": "M8.2 bridge-table LinkBinding request - review candidate only",
  "description": "Non-production candidate. Does not authorize BridgeTable runtime; server must verify source ACL, source catalog and frozen LinkType/M5 revisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "modelSourceRef",
    "packageId",
    "linkTypeId",
    "sourceBindingRef",
    "targetBindingRef",
    "mode",
    "bridgeSourceRef",
    "expectedRevision",
    "idempotencyKey",
    "expectedSchemaFingerprints",
    "validationScope"
  ],
  "properties": {
    "contractVersion": {
      "const": "local-link-binding-v2"
    },
    "modelSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "snapshotId"
      ],
      "properties": {
        "kind": {
          "const": "LOCAL_SNAPSHOT"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "linkTypeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "sourceBindingRef": {
      "$ref": "#/$defs/bindingRef"
    },
    "targetBindingRef": {
      "$ref": "#/$defs/bindingRef"
    },
    "mode": {
      "const": "BRIDGE_TABLE"
    },
    "bridgeSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "schema",
        "table",
        "sourceFkColumn",
        "targetFkColumn"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schema": {
          "const": "public"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "sourceFkColumn": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "targetFkColumn": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        }
      }
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "idempotencyKey": {
      "type": "string",
      "format": "uuid"
    },
    "expectedSchemaFingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "bridge"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bridge": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "coverage"
      ],
      "properties": {
        "kind": {
          "const": "VALIDATION_SCOPE"
        },
        "coverage": {
          "const": "FULL"
        }
      }
    }
  },
  "$defs": {
    "bindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "revision",
        "digest"
      ],
      "properties": {
        "bindingId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854776000
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
