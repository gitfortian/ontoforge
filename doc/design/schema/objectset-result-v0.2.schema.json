{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-system.example.invalid/contracts/v0.2/objectset-result.schema.json",
  "title": "Server-authored ObjectSet Query Result Envelope v0.2",
  "description": "Separate exactness from scope completeness and freshness; partial aggregate is exact only over the known subset. Authorization context is server resolved; no unauthorized object refs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resultVersion": {
      "const": "0.2.0"
    },
    "queryDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemaReleaseDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bindingVersion": {
      "type": "string",
      "minLength": 1
    },
    "indexSnapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "authorizationScopeRef": {
      "type": "string",
      "minLength": 1
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "FAILED"
      ]
    },
    "accuracy": {
      "enum": [
        "EXACT",
        "APPROXIMATE",
        "UNKNOWN"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "freshness": {
      "enum": [
        "FRESH",
        "STALE",
        "UNKNOWN"
      ]
    },
    "answerScope": {
      "enum": [
        "REQUESTED_SCOPE",
        "KNOWN_SUBSET"
      ]
    },
    "sourceCheckpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completeness": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "sourceRef",
          "checkpoint",
          "observedAt",
          "completeness"
        ]
      },
      "minItems": 1
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "COUNT_DISTINCT",
            "SUM",
            "AVG"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation",
        "value"
      ]
    },
    "objectRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approximateErrorBound": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "resultVersion",
    "queryDigest",
    "schemaReleaseDigest",
    "bindingVersion",
    "indexSnapshotRef",
    "authorizationScopeRef",
    "executedAt",
    "status",
    "accuracy",
    "completeness",
    "freshness",
    "answerScope",
    "sourceCheckpoints"
  ],
  "oneOf": [
    {
      "required": [
        "aggregate"
      ],
      "not": {
        "required": [
          "objectRefs"
        ]
      }
    },
    {
      "required": [
        "objectRefs"
      ],
      "not": {
        "required": [
          "aggregate"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "enum": [
              "PARTIAL",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "completeness"
        ]
      },
      "then": {
        "properties": {
          "answerScope": {
            "const": "KNOWN_SUBSET"
          },
          "status": {
            "enum": [
              "PARTIAL",
              "FAILED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCESS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completeness": {
            "const": "COMPLETE"
          },
          "answerScope": {
            "const": "REQUESTED_SCOPE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accuracy": {
            "const": "APPROXIMATE"
          }
        },
        "required": [
          "accuracy"
        ]
      },
      "then": {
        "required": [
          "approximateErrorBound"
        ]
      },
      "else": {
        "not": {
          "required": [
            "approximateErrorBound"
          ]
        }
      }
    }
  ]
}
