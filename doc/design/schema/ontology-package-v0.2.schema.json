{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontology-system.example.invalid/contracts/v0.2/ontology-package.schema.json",
  "title": "Enterprise-native Ontology Package DSL v0.2 (design candidate)",
  "description": "Structural validation only. Reference resolution, authorization, release locks, identity, schema compatibility and executable effects require separate compiler/runtime gates. No credentials or instance facts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import"
      }
    },
    "objectTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectType"
      }
    },
    "linkTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkType"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "linkBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkBinding"
      }
    },
    "objectSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectSet"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "decisionStrategies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "imports",
    "objectTypes",
    "linkTypes",
    "bindings",
    "linkBindings",
    "objectSets",
    "functions",
    "rules",
    "decisionStrategies",
    "policies",
    "actions"
  ],
  "$defs": {
    "import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "packageId",
        "version",
        "digest"
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "apiName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "valueType": {
          "enum": [
            "STRING",
            "INTEGER",
            "DECIMAL",
            "BOOLEAN",
            "DATETIME",
            "ENUM",
            "UUID"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "searchable": {
          "type": "boolean"
        },
        "classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED"
          ]
        },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "apiName",
        "valueType",
        "required",
        "searchable",
        "classification"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "ENUM"
              }
            },
            "required": [
              "valueType"
            ]
          },
          "then": {
            "required": [
              "enumValues"
            ]
          },
          "else": {
            "not": {
              "required": [
                "enumValues"
              ]
            }
          }
        }
      ]
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "apiName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "primaryKeyRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "apiName",
        "primaryKeyRef",
        "properties"
      ]
    },
    "linkType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "apiName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "sourceTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "targetTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "cardinality": {
          "enum": [
            "ONE_TO_ONE",
            "ONE_TO_MANY",
            "MANY_TO_ONE",
            "MANY_TO_MANY"
          ]
        },
        "evidenceRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "apiName",
        "sourceTypeRef",
        "targetTypeRef",
        "cardinality",
        "evidenceRequired"
      ]
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "propertyRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "sourceField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authority": {
          "enum": [
            "AUTHORITATIVE",
            "SUPPLEMENTAL"
          ]
        }
      },
      "required": [
        "propertyRef",
        "sourceField",
        "authority"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "SOURCE_KEY",
            "APPROVED_CROSS_SOURCE"
          ]
        },
        "conflictPolicy": {
          "enum": [
            "REJECT",
            "MANUAL_REVIEW"
          ]
        },
        "evidencePolicyRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        }
      },
      "required": [
        "strategy",
        "conflictPolicy"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceSchemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "objectTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "fieldMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldMapping"
          },
          "minItems": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "refreshMode": {
          "enum": [
            "BATCH",
            "CDC",
            "ON_DEMAND"
          ]
        },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAgeSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "onMissing": {
              "enum": [
                "UNKNOWN",
                "PARTIAL"
              ]
            }
          },
          "required": [
            "maxAgeSeconds",
            "onMissing"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "sourceRef",
        "sourceSchemaVersion",
        "objectTypeRef",
        "sourceKey",
        "fieldMappings",
        "identity",
        "refreshMode",
        "completeness"
      ]
    },
    "linkBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "linkTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceSchemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "targetKey": {
          "type": "string",
          "minLength": 1
        },
        "refreshMode": {
          "enum": [
            "BATCH",
            "CDC",
            "ON_DEMAND"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "linkTypeRef",
        "sourceRef",
        "sourceSchemaVersion",
        "sourceKey",
        "targetKey",
        "refreshMode"
      ]
    },
    "objectSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "rootTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "defaultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "rootTypeRef",
        "defaultLimit"
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "implementationRef": {
          "type": "string",
          "minLength": 1
        },
        "implementationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effectClass": {
          "enum": [
            "READ_ONLY",
            "EDIT_PLAN"
          ]
        },
        "inputTypeRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        },
        "outputType": {
          "enum": [
            "BOOLEAN",
            "INTEGER",
            "DECIMAL",
            "STRING",
            "OBJECT_SET",
            "CHANGE_SET"
          ]
        },
        "declaredEffectTypeRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "required": [
        "id",
        "version",
        "implementationRef",
        "implementationDigest",
        "effectClass",
        "inputTypeRefs",
        "outputType",
        "declaredEffectTypeRefs",
        "timeoutMs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "effectClass": {
                "const": "READ_ONLY"
              }
            },
            "required": [
              "effectClass"
            ]
          },
          "then": {
            "properties": {
              "declaredEffectTypeRefs": {
                "maxItems": 0
              },
              "outputType": {
                "not": {
                  "const": "CHANGE_SET"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effectClass": {
                "const": "EDIT_PLAN"
              }
            },
            "required": [
              "effectClass"
            ]
          },
          "then": {
            "properties": {
              "outputType": {
                "const": "CHANGE_SET"
              }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "ruleArtifactRef": {
          "type": "string",
          "minLength": 1
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mode": {
          "const": "DETERMINISTIC"
        }
      },
      "required": [
        "id",
        "version",
        "ruleArtifactRef",
        "artifactDigest",
        "mode"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "ruleRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        },
        "functionRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "mode": {
          "const": "DETERMINISTIC"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "ruleRefs",
        "functionRef",
        "mode",
        "outcomes"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "kind": {
          "enum": [
            "DATA_ACCESS",
            "ACTION_AUTHORIZATION",
            "APPROVAL"
          ]
        },
        "policyArtifactRef": {
          "type": "string",
          "minLength": 1
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "policyArtifactRef",
        "artifactDigest"
      ]
    },
    "actionEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "UPDATE_OBJECT",
            "CREATE_LINK",
            "EXTERNAL_COMMAND"
          ]
        },
        "targetTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "propertyRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        },
        "executorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "operation",
        "targetTypeRef"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "EXTERNAL_COMMAND"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "executorRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "UPDATE_OBJECT"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "propertyRefs"
            ],
            "properties": {
              "propertyRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/propertyRef"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "apiName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "targetTypeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "functionRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "decisionRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "policyRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "riskClass": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "approvalMode": {
          "enum": [
            "ALWAYS",
            "CONDITIONAL",
            "NONE"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionEffect"
          },
          "minItems": 1
        },
        "idempotency": {
          "const": "REQUIRED"
        },
        "verification": {
          "enum": [
            "EXTERNAL_RECEIPT_AND_BUSINESS_STATE",
            "MANUAL_RECONCILIATION"
          ]
        }
      },
      "required": [
        "id",
        "apiName",
        "version",
        "targetTypeRef",
        "functionRef",
        "decisionRef",
        "policyRefs",
        "riskClass",
        "approvalMode",
        "effects",
        "idempotency",
        "verification"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "riskClass": {
                "enum": [
                  "HIGH",
                  "CRITICAL"
                ]
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approvalMode": {
                "const": "ALWAYS"
              }
            }
          }
        }
      ]
    },
    "propertyRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    }
  }
}
